# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_ID=0
API_HASH=
SECRET_KEY=
ALLOW_PER_ACCOUNT_KEYS=false

CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://aurogram.pages.dev,https://aurogram.dpdns.org
HOST=0.0.0.0
PORT=8000

SESSIONS_DIR=/app/sessions
CACHE_DIR=/app/cache_data
MEDIA_DIR=/app/media_data
CACHE_TTL_DAYS=0
CACHE_MEDIA_TTL_DAYS=0
CACHE_MAX_SIZE_GB=50
CACHE_CLEANUP_INTERVAL_MIN=60
CACHE_TARGET_RATIO=0.9
CACHE_MIN_KEEP_DAYS=7
# true разрешает вытеснять сообщения, если после LRU медиа места всё ещё не хватает
CACHE_EVICT_MESSAGES=false

ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_ACTION_TOKEN=
ADMIN_ACCENT=#6366F1

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Aurogram Studio bot ---
# Токен от @BotFather. Никогда не коммитится: backend/.env в .gitignore.
BOT_TOKEN=
# Белый список Telegram user id через запятую. Пусто = бот молчит для всех,
# кроме запросов с BOT_INTERNAL_SECRET (вебхук/бэкенд).
BOT_ALLOWED_USER_IDS=
# Общий секрет вебхука: Telegram присылает его в X-Telegram-Bot-Api-Secret-Token.
BOT_INTERNAL_SECRET=
# База для кнопки «Играть» в HTML-виджетах (необязательно).
BOT_WIDGET_BASE_URL=

# --- AI (суммаризация постов) ---
# Любая OpenAI-совместимая LLM. По умолчанию DeepSeek.
INVITE_CODE=
DEEPSEEK_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=25

